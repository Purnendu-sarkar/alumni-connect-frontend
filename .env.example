# ==============================================================================
# AlumniConnect Frontend - Academic Demonstration Environment Template (.env.example)
# Note: Copy this file to .env.local for local Next.js development.
# ==============================================================================

# Backend API Base URL (must end with /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Default Tenant Configuration for Registration and Matching
NEXT_PUBLIC_TENANT_DOMAIN=demo.edu
NEXT_PUBLIC_UNIVERSITY_SLUG=demo-university
